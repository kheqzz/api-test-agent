
# --- LLM provider ---
LLM_BASE_URL=https://your-gateway.example/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your-model-name

# --- Agent tuning ---
AGENT_BATCH_SIZE=4
AGENT_MAX_ENDPOINTS=30
AGENT_RATE_LIMIT_RPS=5
AGENT_REQUEST_TIMEOUT=15
AGENT_SLOW_THRESHOLD_MS=1000

# --- Storage ---
REPORTS_DB=reports.db
GENERATED_TESTS_DIR=generated_tests

# --- Optional security and demo settings ---
MOUNT_DEMO=true
AGENT_RESTRICT_TARGETS=false
AGENT_ALLOWED_TARGET_HOSTS=
